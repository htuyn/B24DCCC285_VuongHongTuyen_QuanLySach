<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/canvas" android:orientation="vertical"
    android:paddingStart="18dp" android:paddingEnd="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CHÀO MỪNG BẠN TRỞ LẠI" android:textColor="@color/forest_text"
                android:textSize="10sp" android:letterSpacing="0.12" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Thư viện của tôi" android:textColor="@color/ink"
                android:textSize="27sp" android:fontFamily="serif" android:textStyle="bold" />
        </LinearLayout>
        <Button android:id="@+id/themeButton" android:layout_width="44dp" android:layout_height="44dp"
            android:minWidth="0dp" android:background="@drawable/bg_chip" android:text="☾"
            android:textColor="@color/forest_text" android:contentDescription="Chuyển giao diện sáng/tối" />
        <Button android:id="@+id/logoutButton" android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_marginStart="7dp" android:minWidth="0dp" android:paddingHorizontal="13dp"
            android:background="@drawable/bg_chip" android:text="Thoát" android:textColor="@color/ink" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="13dp" android:background="@drawable/bg_dashboard" android:elevation="3dp"
        android:orientation="vertical" android:padding="15dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="BỘ SƯU TẬP" android:textColor="@color/muted" android:textSize="10sp"
                    android:letterSpacing="0.12" android:textStyle="bold" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:gravity="bottom" android:orientation="horizontal">
                    <TextView android:id="@+id/totalCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0" android:textColor="@color/ink"
                        android:textSize="34sp" android:fontFamily="serif" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="7dp" android:layout_marginBottom="5dp"
                        android:text="cuốn sách" android:textColor="@color/muted" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <Button android:id="@+id/goalButton" android:layout_width="wrap_content" android:layout_height="40dp"
                android:minWidth="0dp" android:paddingHorizontal="12dp" android:backgroundTint="@color/soft_green"
                android:text="Mục tiêu" android:textColor="@color/forest_text" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ĐÃ ĐỌC" android:textColor="@color/muted" android:textSize="9sp" android:letterSpacing="0.08" />
                <TextView android:id="@+id/readCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ĐANG ĐỌC" android:textColor="@color/muted" android:textSize="9sp" android:letterSpacing="0.08" />
                <TextView android:id="@+id/readingStat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHƯA ĐỌC" android:textColor="@color/muted" android:textSize="9sp" android:letterSpacing="0.08" />
                <TextView android:id="@+id/unreadCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/progressLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Hoàn thành 0%" android:textColor="@color/muted" android:textSize="11sp" />
            <ProgressBar android:id="@+id/readingProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="104dp" android:layout_height="6dp" android:max="100" android:progress="0" android:progressTint="@color/forest" android:progressBackgroundTint="@color/progress_track" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/suggestionText" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/forest_text" android:textSize="11sp" />
        <TextView android:id="@+id/genreSummary" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="@color/muted" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
        android:background="@drawable/bg_input" android:elevation="1dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingHorizontal="13dp">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Tìm kiếm"
            android:src="@drawable/ic_search" />
        <EditText android:id="@+id/searchBooks" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@android:color/transparent"
            android:hint="Tìm sách, tác giả, thể loại..." android:imeOptions="actionSearch" android:inputType="text"
            android:paddingStart="8dp" android:singleLine="true" android:textColor="@color/ink" android:textSize="13sp" />
        <Button android:id="@+id/searchClearButton" android:layout_width="34dp" android:layout_height="38dp"
            android:minWidth="0dp" android:background="@android:color/transparent" android:contentDescription="Xóa nội dung tìm kiếm"
            android:text="×" android:textColor="@color/muted" android:textSize="21sp" android:visibility="gone" />
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp"
        android:fillViewport="false" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/allFilterChip" style="@style/FilterChip" android:text="Tất cả" />
            <Button android:id="@+id/unreadFilterChip" style="@style/FilterChip" android:text="Chưa đọc" />
            <Button android:id="@+id/readingShortcut" style="@style/FilterChip" android:text="Đang đọc" />
            <Button android:id="@+id/readFilterChip" style="@style/FilterChip" android:text="Đã đọc" />
            <Button android:id="@+id/favoritesShortcut" style="@style/FilterChip" android:text="Yêu thích" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="3dp" android:orientation="horizontal">
        <Spinner android:id="@+id/filterSpinner" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_input"
            android:contentDescription="Lọc theo thể loại" android:paddingHorizontal="9dp" />
        <Spinner android:id="@+id/sortSpinner" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_input"
            android:contentDescription="Sắp xếp sách" android:paddingHorizontal="9dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="KỆ SÁCH" android:textColor="@color/ink" android:textSize="12sp" android:letterSpacing="0.1" android:textStyle="bold" />
        <Button android:id="@+id/addBookButton" android:layout_width="wrap_content" android:layout_height="40dp"
            android:minWidth="0dp" android:paddingHorizontal="15dp" android:backgroundTint="@color/forest"
            android:text="＋  Thêm sách" android:textColor="@color/ink" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/emptyMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_card" android:elevation="2dp" android:gravity="center" android:padding="20dp"
        android:text="Kệ sách đang yên tĩnh. Hãy thêm một cuốn sách để bắt đầu." android:textColor="@color/muted" android:visibility="gone" />
    <LinearLayout android:id="@+id/undoBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:background="@drawable/bg_card" android:elevation="2dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="5dp" android:visibility="gone">
        <TextView android:id="@+id/undoMessage" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:maxLines="2" android:textColor="@color/ink" android:textSize="12sp" />
        <Button android:id="@+id/undoButton" android:layout_width="wrap_content" android:layout_height="40dp"
            android:minWidth="0dp" android:backgroundTint="@color/soft_green" android:text="Hoàn tác" android:textColor="@color/forest_text" />
    </LinearLayout>
    <ListView android:id="@+id/bookList" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@android:color/transparent" android:clipToPadding="false"
        android:divider="@android:color/transparent" android:dividerHeight="10dp" android:paddingTop="7dp"
        android:paddingBottom="8dp" android:scrollbars="none" />
</LinearLayout>
