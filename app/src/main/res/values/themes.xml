<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuanLySach" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/forest</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:buttonStyle">@style/Widget.Library.Button</item>
        <item name="android:colorControlActivated">@color/forest</item>
    </style>
    <style name="Widget.Library.Button" parent="android:Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/forest</item>
        <item name="android:backgroundTint">@color/soft_green</item>
    </style>
    <style name="FilterChip" parent="android:Widget.Material.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/forest_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="StatCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>
    <style name="StatNumber">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FormInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="DetailValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
